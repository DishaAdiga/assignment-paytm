{
  "info": {
    "name": "Wallet Service",
    "_postman_id": "6f6a8b6a-6e0a-4a4a-9b0a-wallet-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Metrics",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/health" }
        },
        {
          "name": "Metrics",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/metrics" }
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Create/Get Wallet A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('wallet_a_id', data.id);",
                  "console.log('wallet_a_id =', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_a}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initial_balance_paise\": 100000\n}"
            },
            "url": "{{base_url}}/wallets"
          }
        },
        {
          "name": "Create/Get Wallet B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('wallet_b_id', data.id);",
                  "console.log('wallet_b_id =', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_b}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initial_balance_paise\": 0\n}"
            },
            "url": "{{base_url}}/wallets"
          }
        },
        {
          "name": "Get Wallet A Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/wallets/{{wallet_a_id}}"
          }
        },
        {
          "name": "Get Wallet B Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/wallets/{{wallet_b_id}}"
          }
        },
        {
          "name": "Get Wallet A - wrong owner (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/wallets/{{wallet_a_id}}"
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "1. Create Transfer (A -> B)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('idempotency_key')) {",
                  "  pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 or 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('transfer_id', data.id);",
                  "pm.test('status field is completed', function () { pm.expect(data.status).to.eql('completed'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_a}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{wallet_a_id}}\",\n  \"to\": \"{{wallet_b_id}}\",\n  \"amount_paise\": 2500,\n  \"idempotency_key\": \"{{idempotency_key}}\"\n}"
            },
            "url": "{{base_url}}/transfers"
          }
        },
        {
          "name": "2. Retry Same Transfer (idempotent replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 (replay) or 201 (first hit)', function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "pm.test('same transfer id as before', function () { pm.expect(data.id).to.eql(pm.environment.get('transfer_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_a}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{wallet_a_id}}\",\n  \"to\": \"{{wallet_b_id}}\",\n  \"amount_paise\": 2500,\n  \"idempotency_key\": \"{{idempotency_key}}\"\n}"
            },
            "url": "{{base_url}}/transfers"
          }
        },
        {
          "name": "3. Replay With Different Body (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_a}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{wallet_a_id}}\",\n  \"to\": \"{{wallet_b_id}}\",\n  \"amount_paise\": 9999,\n  \"idempotency_key\": \"{{idempotency_key}}\"\n}"
            },
            "url": "{{base_url}}/transfers"
          }
        },
        {
          "name": "4. Get Transfer Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/transfers/{{transfer_id}}"
          }
        },
        {
          "name": "5. Overdraft attempt (expect declined)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set('idempotency_key_overdraft', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('declined for insufficient funds', function () {",
                  "  pm.expect(data.status).to.eql('declined');",
                  "  pm.expect(data.decline_reason).to.eql('insufficient_funds');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_a}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{wallet_a_id}}\",\n  \"to\": \"{{wallet_b_id}}\",\n  \"amount_paise\": 999999999,\n  \"idempotency_key\": \"{{idempotency_key_overdraft}}\"\n}"
            },
            "url": "{{base_url}}/transfers"
          }
        },
        {
          "name": "6. Transfer from wallet you don't own (expect 403)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set('idempotency_key_forbidden', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_b}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{wallet_a_id}}\",\n  \"to\": \"{{wallet_b_id}}\",\n  \"amount_paise\": 100,\n  \"idempotency_key\": \"{{idempotency_key_forbidden}}\"\n}"
            },
            "url": "{{base_url}}/transfers"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ]
}
